generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum ObligationStatus { PENDING OVERDUE PARTIALLY_PAID PAID CANCELLED }
enum PaymentStatus { PENDING_VALIDATION VALIDATED REJECTED CANCELLED }
enum PaymentMethod { TRANSFER DEPOSIT CASH OTHER }
enum CreditMovementType { SURPLUS APPLICATION CANCELLATION_REVERSAL }
enum ClientType { INDIVIDUAL LEGAL_ENTITY }

model Tenant { id String @id @default(uuid()) @db.Uuid clientId String @unique @map("client_id") @db.VarChar(100) name String @db.VarChar(150) cuit String @unique @db.VarChar(11) createdAt DateTime @default(now()) @map("created_at") clients AccountingClient[] obligations PaymentObligation[] settings StudioNotificationSettings? payments PaymentSubmission[] credits CustomerCreditBalance[] movements CreditBalanceMovement[] claims DebtClaimHistory[] audits ChangeAuditEntry[] tokens QuickActionToken[] @@map("tenants") }
model StudioNotificationSettings { id String @id @default(uuid()) @db.Uuid tenantId String @unique @db.Uuid graceAfterDueDays Int @default(1) reminderIntervalDays Int @default(7) updatedAt DateTime @updatedAt updatedByUserId String @db.Uuid tenant Tenant @relation(fields: [tenantId], references: [id]) @@check(graceAfterDueDays >= 0 AND graceAfterDueDays <= 30) @@check(reminderIntervalDays >= 1 AND reminderIntervalDays <= 60) @@map("studio_notification_settings") }
model AccountingClient { id String @id(map: "accounting_clients_pkey") @default(uuid()) @db.Uuid tenantId String @db.Uuid representativeAccountantId String? @db.Uuid businessName String @db.VarChar(200) cuit String @db.VarChar(11) email String @db.VarChar(320) phone String? @db.VarChar(40) status String @default("ACTIVE") type ClientType @default(LEGAL_ENTITY) firstName String? @db.VarChar(120) lastName String? @db.VarChar(120) legalName String? @db.VarChar(200) tradeName String? @db.VarChar(200) taxAddress String? @db.VarChar(300) legalRepresentativeName String? @db.VarChar(200) legalRepresentativeTaxId String? @db.VarChar(11) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt tenant Tenant @relation(fields: [tenantId], references: [id], map: "accounting_clients_tenantId_fkey") obligations PaymentObligation[] credit CustomerCreditBalance? movements CreditBalanceMovement[] @@index([tenantId], map: "accounting_clients_tenantId_idx") @@unique([tenantId, cuit], map: "accounting_clients_tenantId_cuit_key") @@map("clients") }
model PaymentObligation { id String @id @default(uuid()) @db.Uuid tenantId String @db.Uuid clientId String @db.Uuid serviceDescription String @db.VarChar(255) periodStartDate DateTime @db.Date periodEndDate DateTime @db.Date dueDate DateTime @db.Date currency String @default("ARS") @db.VarChar(3) totalAmount Decimal @db.Decimal(14,2) balanceDue Decimal @db.Decimal(14,2) status ObligationStatus @default(PENDING) cancelledReason String? createdByUserId String @db.Uuid cancelledAt DateTime? cancelledByUserId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt tenant Tenant @relation(fields: [tenantId], references: [id]) client AccountingClient @relation(fields: [clientId], references: [id]) payments PaymentSubmission[] claims DebtClaimHistory[] tokens QuickActionToken[] movements CreditBalanceMovement[] @@index([tenantId, status]) @@map("payment_obligations") }
model PaymentSubmission { id String @id @default(uuid()) @db.Uuid tenantId String @db.Uuid obligationId String @db.Uuid reportedByUserId String? @db.Uuid reportedByClient Boolean @default(false) paymentDate DateTime @db.Date amount Decimal @db.Decimal(14,2) paymentMethod PaymentMethod receiptFileUrl String? @db.VarChar(500) receiptFileName String? @db.VarChar(255) receiptFileSizeBytes BigInt? receiptFileMimeType String? @db.VarChar(100) status PaymentStatus @default(PENDING_VALIDATION) rejectionReason String? cancellationReason String? resolvedAt DateTime? resolvedByUserId String? cancelledAt DateTime? cancelledByUserId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt tenant Tenant @relation(fields: [tenantId], references: [id]) obligation PaymentObligation @relation(fields: [obligationId], references: [id]) @@index([tenantId, obligationId]) @@map("payment_submissions") }
model CustomerCreditBalance { id String @id @default(uuid()) @db.Uuid tenantId String @db.Uuid clientId String @unique @db.Uuid availableAmount Decimal @default(0) @db.Decimal(14,2) updatedAt DateTime @updatedAt tenant Tenant @relation(fields: [tenantId], references: [id]) client AccountingClient @relation(fields: [clientId], references: [id]) movements CreditBalanceMovement[] @@map("customer_credit_balances") }
model CreditBalanceMovement { id String @id @default(uuid()) @db.Uuid tenantId String @db.Uuid clientId String @db.Uuid creditBalanceId String @db.Uuid type CreditMovementType amount Decimal @db.Decimal(14,2) sourcePaymentSubmissionId String? @db.Uuid targetObligationId String? @db.Uuid createdByUserId String @db.Uuid createdAt DateTime @default(now()) tenant Tenant @relation(fields: [tenantId], references: [id]) balance CustomerCreditBalance @relation(fields: [creditBalanceId], references: [id]) obligation PaymentObligation? @relation(fields: [targetObligationId], references: [id]) @@index([tenantId, clientId]) @@map("credit_balance_movements") }
model DebtClaimHistory { id String @id @default(uuid()) @db.Uuid tenantId String @db.Uuid obligationId String @db.Uuid claimType String recipientEmail String bccEmails String subject String body String status String attemptCount Int @default(0) errorMessage String? triggeredByUserId String? dispatchedAt DateTime @default(now()) tenant Tenant @relation(fields: [tenantId], references: [id]) obligation PaymentObligation @relation(fields: [obligationId], references: [id]) @@map("debt_claim_history") }
model QuickActionToken { id String @id @default(uuid()) @db.Uuid tenantId String @db.Uuid obligationId String @db.Uuid tokenJti String @unique expiresAt DateTime isUsed Boolean @default(false) usedAt DateTime? createdAt DateTime @default(now()) tenant Tenant @relation(fields: [tenantId], references: [id]) obligation PaymentObligation @relation(fields: [obligationId], references: [id]) @@map("quick_action_tokens") }
model ChangeAuditEntry { id String @id @default(uuid()) tenantId String @db.Uuid entityType String entityId String @db.Uuid action String fieldName String? oldValue String? newValue String? reason String? performedByUserId String @db.Uuid createdAt DateTime @default(now()) tenant Tenant @relation(fields: [tenantId], references: [id]) @@index([tenantId, entityType, entityId]) @@map("change_audit_entries") }
