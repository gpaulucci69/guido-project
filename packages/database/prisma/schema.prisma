generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String             @id @default(uuid()) @db.Uuid
  clientId  String             @unique @map("client_id") @db.VarChar(100)
  name      String             @db.VarChar(150)
  cuit      String             @unique @db.VarChar(11)
  clients   AccountingClient[]
  @@map("tenants")
}

model AccountingClient {
  id                         String @id @default(uuid()) @db.Uuid
  tenantId                   String @db.Uuid
  representativeAccountantId String? @db.Uuid
  businessName               String @db.VarChar(200)
  cuit                       String @db.VarChar(11)
  email                      String @db.VarChar(320)
  phone                      String? @db.VarChar(40)
  status                     String @default("ACTIVE")
  tenant                     Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  @@map("accounting_clients")
}
