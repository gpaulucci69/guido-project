generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientType {
  INDIVIDUAL
  LEGAL_ENTITY
}

model Tenant {
  id        String             @id @default(uuid()) @db.Uuid
  clientId  String             @unique @map("client_id") @db.VarChar(100)
  name      String             @db.VarChar(150)
  cuit      String             @unique @db.VarChar(11)
  clients   AccountingClient[]
  @@map("tenants")
}

model AccountingClient {
  id                         String @id @default(uuid()) @db.Uuid
  tenantId                   String @db.Uuid
  representativeAccountantId String? @db.Uuid
  businessName               String @db.VarChar(200)
  cuit                       String @db.VarChar(11)
  email                      String @db.VarChar(320)
  phone                      String? @db.VarChar(40)
  status                     String @default("ACTIVE")
  type                       ClientType @default(LEGAL_ENTITY)
  firstName                  String? @db.VarChar(120)
  lastName                   String? @db.VarChar(120)
  legalName                  String? @db.VarChar(200)
  tradeName                  String? @db.VarChar(200)
  taxAddress                 String? @db.VarChar(300)
  legalRepresentativeName    String? @db.VarChar(200)
  legalRepresentativeTaxId   String? @db.VarChar(11)
  updatedAt                  DateTime @updatedAt
  tenant                     Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  @@unique([tenantId, cuit])
  @@map("accounting_clients")
}
