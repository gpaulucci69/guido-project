{
  "name": "saas-contable",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:business": "vitest run --coverage",
    "build": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "prisma": "^6.19.3",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tanstack/table-core": "^8.21.3",
    "minio": "^8.0.7",
    "oidc-client-ts": "^3.5.0"
  }
}
